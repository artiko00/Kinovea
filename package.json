{
  "name": "kinovea-harness",
  "private": true,
  "description": "Agent harness tooling for Kinovea (linters only; the app itself is a .NET solution)",
  "scripts": {
    "lint:lines": "linelens check --fail",
    "lint:dupes": "dupelens check --fail",
    "lint:secrets": "secretlens check --fail",
    "lint:tests": "testlens check --fail",
    "lint": "npm run lint:lines && npm run lint:dupes && npm run lint:secrets && npm run lint:tests"
  },
  "devDependencies": {
    "@open_harness/open-harness": "^0.3.7"
  },
  "linelens": {
    "default": {
      "maxLines": 150
    },
    "exclude": [
      "node_modules",
      ".git",
      "packages",
      "bin",
      "obj",
      "openspec",
      ".agents",
      ".claude",
      ".hermes",
      ".agent",
      "rust/target",
      "tests/fixtures",
      "Kinovea",
      "Kinovea.Camera",
      "Kinovea.Camera.Basler",
      "Kinovea.Camera.Baumer",
      "Kinovea.Camera.Daheng",
      "Kinovea.Camera.DirectShow",
      "Kinovea.Camera.FrameGenerator",
      "Kinovea.Camera.GenICam",
      "Kinovea.Camera.HTTP",
      "Kinovea.Camera.IDS",
      "Kinovea.FileBrowser",
      "Kinovea.Pipeline",
      "Kinovea.ScreenManager",
      "Kinovea.Services",
      "Kinovea.Tests",
      "Kinovea.Updater",
      "Kinovea.Video",
      "Kinovea.Video.Bitmap",
      "Kinovea.Video.FFMpeg",
      "Kinovea.Video.Gif",
      "Kinovea.Video.SVG",
      "Installer",
      "Tools",
      "VideoTests",
      "Refs"
    ]
  },
  "dupelens": {
    "default": {
      "minTokens": 50,
      "minLines": 5
    },
    "exclude": [
      "node_modules",
      ".git",
      "packages",
      "bin",
      "obj",
      "openspec",
      ".agents",
      ".claude",
      ".hermes",
      ".agent",
      "rust/target",
      "tests/fixtures",
      "Kinovea",
      "Kinovea.Camera",
      "Kinovea.Camera.Basler",
      "Kinovea.Camera.Baumer",
      "Kinovea.Camera.Daheng",
      "Kinovea.Camera.DirectShow",
      "Kinovea.Camera.FrameGenerator",
      "Kinovea.Camera.GenICam",
      "Kinovea.Camera.HTTP",
      "Kinovea.Camera.IDS",
      "Kinovea.FileBrowser",
      "Kinovea.Pipeline",
      "Kinovea.ScreenManager",
      "Kinovea.Services",
      "Kinovea.Tests",
      "Kinovea.Updater",
      "Kinovea.Video",
      "Kinovea.Video.Bitmap",
      "Kinovea.Video.FFMpeg",
      "Kinovea.Video.Gif",
      "Kinovea.Video.SVG",
      "Installer",
      "Tools",
      "VideoTests",
      "Refs"
    ]
  },
  "secretlens": {
    "allowlist": [
      "example",
      "placeholder",
      "changeme"
    ],
    "exclude": [
      "node_modules",
      ".git",
      "packages",
      "bin",
      "obj",
      "openspec",
      ".agents",
      ".claude",
      ".hermes",
      ".agent",
      "rust/target",
      "tests/fixtures",
      "Kinovea",
      "Kinovea.Camera",
      "Kinovea.Camera.Basler",
      "Kinovea.Camera.Baumer",
      "Kinovea.Camera.Daheng",
      "Kinovea.Camera.DirectShow",
      "Kinovea.Camera.FrameGenerator",
      "Kinovea.Camera.GenICam",
      "Kinovea.Camera.HTTP",
      "Kinovea.Camera.IDS",
      "Kinovea.FileBrowser",
      "Kinovea.Pipeline",
      "Kinovea.ScreenManager",
      "Kinovea.Services",
      "Kinovea.Tests",
      "Kinovea.Updater",
      "Kinovea.Video",
      "Kinovea.Video.Bitmap",
      "Kinovea.Video.FFMpeg",
      "Kinovea.Video.Gif",
      "Kinovea.Video.SVG",
      "Installer",
      "Tools",
      "VideoTests",
      "Refs",
      "*.lock",
      "*.pfx",
      "*.snk",
      "*.png",
      "*.ico",
      "**/*.csproj",
      "**/app.config",
      "**/packages.config"
    ]
  },
  "testlens": {
    "language": "rust",
    "exclude": [
      "node_modules",
      ".git",
      "packages",
      "bin",
      "obj",
      "openspec",
      ".agents",
      ".claude",
      ".hermes",
      ".agent",
      "rust/target",
      "tests/fixtures",
      "Kinovea",
      "Kinovea.Camera",
      "Kinovea.Camera.Basler",
      "Kinovea.Camera.Baumer",
      "Kinovea.Camera.Daheng",
      "Kinovea.Camera.DirectShow",
      "Kinovea.Camera.FrameGenerator",
      "Kinovea.Camera.GenICam",
      "Kinovea.Camera.HTTP",
      "Kinovea.Camera.IDS",
      "Kinovea.FileBrowser",
      "Kinovea.Pipeline",
      "Kinovea.ScreenManager",
      "Kinovea.Services",
      "Kinovea.Tests",
      "Kinovea.Updater",
      "Kinovea.Video",
      "Kinovea.Video.Bitmap",
      "Kinovea.Video.FFMpeg",
      "Kinovea.Video.Gif",
      "Kinovea.Video.SVG",
      "Installer",
      "Tools",
      "VideoTests",
      "Refs"
    ]
  }
}
