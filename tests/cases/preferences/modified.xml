<?xml version="1.0" encoding="utf-8"?>
<KinoveaPreferences>
  <FormatVersion>3.0</FormatVersion>
  <General>
    <Culture>es</Culture>
    <EnableDebugLog>true</EnableDebugLog>
    <EnableAllLanguages>true</EnableAllLanguages>
    <PreferencesPage>2</PreferencesPage>
    <Pointer>::big</Pointer>
    <FutureSetting>ignored</FutureSetting>
  </General>
  <FileExplorer>
    <MaxRecentFiles>5</MaxRecentFiles>
    <RecentFiles>
      <RecentFile>C:\Videos\jump.mp4</RecentFile>
      <RecentFile>C:\Videos\sprint.mkv</RecentFile>
    </RecentFiles>
    <MaxRecentCapturedFiles>7</MaxRecentCapturedFiles>
    <FileSortAscending>false</FileSortAscending>
    <UseDriveIcons>false</UseDriveIcons>
  </FileExplorer>
  <Player>
    <DecimalPlaces>3</DecimalPlaces>
    <TimecodeFormat>Frames</TimecodeFormat>
    <SpeedUnit>KilometersPerHour</SpeedUnit>
    <AccelerationUnit>FeetPerSecondSquared</AccelerationUnit>
    <AngleUnit>Radian</AngleUnit>
    <AngularVelocityUnit>RevolutionsPerMinute</AngularVelocityUnit>
    <AngularAccelerationUnit>RadiansPerSecondSquared</AngularAccelerationUnit>
    <CustomLengthUnit>stride</CustomLengthUnit>
    <CustomLengthAbbreviation>st</CustomLengthAbbreviation>
    <CadenceUnit>StepsPerMinute</CadenceUnit>
    <ExportImagesInDocuments>false</ExportImagesInDocuments>
    <DeinterlaceByDefault>true</DeinterlaceByDefault>
    <InteractiveFrameTracker>false</InteractiveFrameTracker>
    <WorkingZoneMemory>2048</WorkingZoneMemory>
    <SyncLockSpeed>false</SyncLockSpeed>
    <SyncByMotion>true</SyncByMotion>
    <EnablePixelFiltering>false</EnablePixelFiltering>
    <DrawOnPlay>false</DrawOnPlay>
    <RecentColors>
      <RecentColor>255;0;0</RecentColor>
      <RecentColor>0;128;255</RecentColor>
    </RecentColors>
    <EnableFiltering>false</EnableFiltering>
    <EnableCustomToolsDebugMode>true</EnableCustomToolsDebugMode>
    <DetectImageSequences>false</DetectImageSequences>
    <PreloadKeyframes>5</PreloadKeyframes>
    <PlaybackKVA>C:\Videos\default.kva</PlaybackKVA>
    <PandocPath>C:\Tools\pandoc.exe</PandocPath>
    <SideBySideHorizontal>false</SideBySideHorizontal>
    <EnableFrameSkipping>false</EnableFrameSkipping>
    <TimelineJumpSmallSize>0.25</TimelineJumpSmallSize>
    <TimelineJumpLargeSize>5</TimelineJumpLargeSize>
    <SpeedLabelFactor>false</SpeedLabelFactor>
    <SpeedLabelFramerate>true</SpeedLabelFramerate>
    <SpeedLabelInterval>true</SpeedLabelInterval>
    <LoopPlayback>false</LoopPlayback>
    <EnableHardwareDecoding>false</EnableHardwareDecoding>
    <EnablePreviewScaling>false</EnablePreviewScaling>
    <EnableHardwareScaling>false</EnableHardwareScaling>
  </Player>
  <Capture>
    <DisplaySynchronizationFramerate>50.000</DisplaySynchronizationFramerate>
    <VerboseStats>true</VerboseStats>
    <SaveUncompressedVideo>true</SaveUncompressedVideo>
    <MemoryBuffer>1024</MemoryBuffer>
    <EnableFramerateReplacement>false</EnableFramerateReplacement>
    <HighspeedRecordingFramerateThreshold>240.000</HighspeedRecordingFramerateThreshold>
    <HighspeedRecordingFramerateOutput>25.000</HighspeedRecordingFramerateOutput>
    <SlowspeedRecordingFramerateThreshold>2.000</SlowspeedRecordingFramerateThreshold>
    <SlowspeedRecordingFramerateOutput>24.000</SlowspeedRecordingFramerateOutput>
    <CaptureKVA>C:\Videos\capture.kva</CaptureKVA>
    <ContextEnabled>false</ContextEnabled>
    <ContextString>session-%date%</ContextString>
  </Capture>
  <FutureSection>
    <Value>1</Value>
  </FutureSection>
</KinoveaPreferences>
