<?xml version="1.0" encoding="utf-8"?>
<KinoveaVideoAnalysis>
  <FormatVersion>2.1</FormatVersion>
  <Producer>hand-written</Producer>
  <OriginalFilename>geometry</OriginalFilename>
  <ImageSize>320;240</ImageSize>
  <AverageTimeStampsPerFrame>40</AverageTimeStampsPerFrame>
  <FirstTimeStamp>0</FirstTimeStamp>
  <SelectionStart>0</SelectionStart>
  <Keyframes>
    <Keyframe>
      <Timestamp>0</Timestamp>
      <Name>shapes</Name>
      <Drawings>
        <Line><Start>20;20</Start><End>150;60</End><ExtraData>None</ExtraData>
          <DrawingStyle><Color Key="color"><Value>255;255;0;0</Value></Color><LineSize Key="line size"><Value>4</Value></LineSize><LineShape Key="line shape"><Value>Solid</Value></LineShape><Arrows Key="arrows"><Value>EndArrow</Value></Arrows></DrawingStyle></Line>
        <Line><Start>20;90</Start><End>150;90</End><ExtraData>None</ExtraData>
          <DrawingStyle><Color Key="color"><Value>255;0;0;255</Value></Color><LineSize Key="line size"><Value>3</Value></LineSize><LineShape Key="line shape"><Value>Dash</Value></LineShape><Arrows Key="arrows"><Value>DoubleArrow</Value></Arrows></DrawingStyle></Line>
        <Line><Start>20;120</Start><End>150;150</End><ExtraData>None</ExtraData>
          <DrawingStyle><Color Key="color"><Value>255;0;128;0</Value></Color><LineSize Key="line size"><Value>2</Value></LineSize><LineShape Key="line shape"><Value>Squiggle</Value></LineShape><Arrows Key="arrows"><Value>None</Value></Arrows></DrawingStyle></Line>
        <Circle><Origin>230;60</Origin><Radius>35</Radius><ExtraData>None</ExtraData>
          <DrawingStyle><Color Key="color"><Value>255;200;0;200</Value></Color><PenSize Key="pen size"><Value>3</Value></PenSize><PenShape Key="pen shape"><Value>Solid</Value></PenShape></DrawingStyle></Circle>
        <Rectangle><PointUpperLeft>190;120</PointUpperLeft><PointUpperRight>300;120</PointUpperRight><PointLowerRight>300;170</PointLowerRight><PointLowerLeft>190;170</PointLowerLeft>
          <DrawingStyle><Color Key="color"><Value>255;0;160;160</Value></Color><PenSize Key="pen size"><Value>2</Value></PenSize></DrawingStyle></Rectangle>
        <Pencil><PointList Count="5"><Point>30;180</Point><Point>50;200</Point><Point>70;185</Point><Point>90;215</Point><Point>110;190</Point></PointList>
          <DrawingStyle><Color Key="color"><Value>255;0;0;0</Value></Color><PenSize Key="pen size"><Value>4</Value></PenSize></DrawingStyle></Pencil>
        <Polyline><PointList Count="4"><Point key="0">130;200</Point><Point key="1">160;180</Point><Point key="2">190;220</Point><Point key="3">220;195</Point></PointList>
          <DrawingStyle><Color Key="color"><Value>255;255;128;0</Value></Color><LineSize Key="line size"><Value>3</Value></LineSize></DrawingStyle></Polyline>
        <CrossMark><CenterPoint>270;210</CenterPoint><ExtraData>None</ExtraData>
          <DrawingStyle><Color Key="back color"><Value>255;255;255;0</Value></Color></DrawingStyle></CrossMark>
      </Drawings>
    </Keyframe>
    <Keyframe>
      <Timestamp>400</Timestamp>
      <Name>grid</Name>
      <Drawings>
        <Plane><PointUpperLeft>40;40</PointUpperLeft><PointUpperRight>260;55</PointUpperRight><PointLowerRight>280;200</PointLowerRight><PointLowerLeft>30;210</PointLowerLeft><ShowGrid>true</ShowGrid>
          <DrawingStyle><Color Key="color"><Value>255;255;255;255</Value></Color></DrawingStyle></Plane>
      </Drawings>
    </Keyframe>
  </Keyframes>
</KinoveaVideoAnalysis>
