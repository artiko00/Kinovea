<?xml version="1.0" encoding="utf-8"?>
<office:document-content xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:number="urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0" office:version="1.2">
  <office:font-face-decls>
    <style:font-face style:name="Calibri" svg:font-family="Calibri" />
    <style:font-face style:name="Liberation Sans" svg:font-family="&amp;apos;Liberation Sans&amp;apos;" />
    <style:font-face style:name="Arial" svg:font-family="Arial" style:font-family-generic="system" />
  </office:font-face-decls>
  <office:automatic-styles>
    <number:number-style style:name="N0">
      <number:number number:min-integer-digits="1" number:decimal-places="2" />
    </number:number-style>
    <number:number-style style:name="N1">
      <number:number number:min-integer-digits="1" number:decimal-places="3" />
    </number:number-style>
    <style:style style:name="CO1" style:family="table-column">
      <style:table-column-properties style:use-optimal-column-width="true" />
    </style:style>
    <style:style style:name="kfHeader" style:family="table-cell">
      <style:table-cell-properties fo:border="0.06pt solid #000000" fo:background-color="#d2f5b0" />
      <style:paragraph-properties fo:text-align="center" />
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" fo:font-weight="bold" />
    </style:style>
    <style:style style:name="timeHeader" style:family="table-cell">
      <style:table-cell-properties fo:border="0.06pt solid #000000" fo:background-color="#c2dfff" />
      <style:paragraph-properties fo:text-align="center" />
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" fo:font-weight="bold" />
    </style:style>
    <style:style style:name="trackHeader" style:family="table-cell">
      <style:table-cell-properties fo:border="0.06pt solid #000000" fo:background-color="#ffddfd" />
      <style:paragraph-properties fo:text-align="center" />
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" fo:font-weight="bold" />
    </style:style>
    <style:style style:name="valueHeader" style:family="table-cell">
      <style:table-cell-properties fo:border="0.06pt solid #000000" fo:background-color="#e8e8e8" />
      <style:paragraph-properties fo:text-align="center" />
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" />
    </style:style>
    <style:style style:name="name" style:family="table-cell">
      <style:table-cell-properties fo:border="0.06pt solid #000000" />
      <style:paragraph-properties />
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" />
    </style:style>
    <style:style style:name="number" style:family="table-cell" style:data-style-name="N0">
      <style:table-cell-properties fo:border="0.06pt solid #000000" />
      <style:paragraph-properties />
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" />
    </style:style>
    <style:style style:name="time" style:family="table-cell" style:data-style-name="N1">
      <style:table-cell-properties fo:border="0.06pt solid #000000" />
      <style:paragraph-properties />
      <style:text-properties style:font-name="Calibri" fo:font-size="11pt" />
    </style:style>
  </office:automatic-styles>
  <office:body>
    <office:spreadsheet>
      <table:table table:name="Sheet1">
        <table:table-column table:style-name="CO1" />
      </table:table>
    </office:spreadsheet>
  </office:body>
</office:document-content>